generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * Images Bounded Context
 */

// Write side
enum ImageStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model Image {
  id         String      @id @unique @default(uuid(4))
  title      String      @db.VarChar(120)
  storageKey String      @unique
  status     ImageStatus @default(PROCESSING)
  width      Int
  height     Int
  mimeType   String      @db.VarChar(50)

  @@map("images")
}

// Read side
model ImageRead {
  id      String @id @unique @default(uuid(4))
  imageId String @unique
  title   String @db.VarChar(120)
  width   Int
  height  Int
  url     String

  @@index([title])
  @@index([imageId])
  @@map("image_read")
}
